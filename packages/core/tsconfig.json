{
  "//": "IDE-default config. For production emits use tsconfig.build.json.",
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": [
      "node",
      "react",
      "vitest/globals",
      "@testing-library/jest-dom"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/types"
  ],
  "exclude": [
    "node_modules",
    "**/dist/*"
  ]
}
